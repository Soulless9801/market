{
	"compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",

		"paths": {
			"@/*": ["./src/*"]
		},

        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
		"rewriteRelativeImportExtensions": true,
        "noEmit": true
	},
	"include": ["scripts/**/*"],
}
